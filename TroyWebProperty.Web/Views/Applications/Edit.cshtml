@model ApplicationEditModel
@{ ViewData["Title"] = $"Application {Model.Id}"; }
<div id="application-shell">
    <nav aria-label="Breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Applications</a></li>
            <li class="breadcrumb-item active" aria-current="page">Application #@Model.Id</li>
        </ol>
    </nav>
    <h1 class="mt-3">Application #@Model.Id</h1>
    <p class="lead">@Model.UnitDescription @Html.DisplayFor(static model => model.Status, "ApplicationStatus")</p>
    @if (Model.ReturnComment is not null)
    {
        <p class="alert alert-warning">Returned for correction: @Model.ReturnComment</p>
    }
    @if (Model.ReadOnly)
    {
        <p class="alert alert-info">This application is read-only.</p>
    }
    <nav class="nav nav-pills wizard-steps gap-2 my-4" aria-label="Application sections">
        @foreach (var step in Enumerable.Range(1, 3))
        {
            <a class="nav-link @(Model.Step == step ? "active" : "")" asp-action="Edit" asp-route-id="@Model.Id"
               asp-route-step="@step"
               aria-current="@(Model.Step == step ? "step" : null)">@(step == 1 ? "1. Applicant information" : step == 2 ? "2. Residence history" : "3. Summary")</a>
        }
    </nav>
    <form asp-action="Edit" method="post" class="card card-body workflow-card">
        <input asp-for="Id" type="hidden"/><input asp-for="RowVersion" type="hidden"/><input asp-for="Step"
                                                                                             type="hidden"/>
        <div asp-validation-summary="All" class="validation-summary" role="alert"></div>
        @if (Model.Step == 1)
        {
            <partial name="_ApplicantSection" model="Model"/>
        }
        else if (Model.Step == 2)
        {
            <partial name="_HistorySection" model="Model"/>
        }
        else
        {
            <partial name="_Summary" model="Model"/>
        }
        @if (!Model.ReadOnly)
        {
            <div class="form-actions">
                @if (Model.Step > 1)
                {
                    <button name="command" value="Back" type="submit" formnovalidate class="btn btn-outline-secondary">
                        Back without saving
                    </button>
                }
                @if (Model.Step < 3)
                {
                    <button name="command" value="Continue" type="submit" class="btn btn-primary">Save and continue
                    </button>
                }
                else if (Model.CanSubmit)
                {
                    <button name="command" value="Submit" type="submit" class="btn btn-primary">Submit application
                    </button>
                }
                else
                {
                    <p class="alert alert-warning">Save both sections before submitting.</p>
                }
            </div>
        }
    </form>
    @if (Model.CanWithdraw)
    {
        <form asp-action="Withdraw" method="post" class="mt-4"><input type="hidden" name="id" value="@Model.Id"/><input
                type="hidden" name="rowVersion" value="@Model.RowVersion"/>
            <button class="btn btn-outline-danger" type="submit">Withdraw application</button>
        </form>
    }
    @if (Model.Manager && Model.Status == "Submitted")
    {
        <button type="button" class="btn btn-primary mt-4"
                data-modal-url="@Url.Action("Review", new { id = Model.Id })">Review application
        </button>
    }
    @if (Model.Lease is not null)
    {
        <div class="alert alert-success mt-4"><h2 class="h5">Twelve-month lease</h2>
            <p>Starts @Model.Lease.StartDate.ToString("yyyy-MM-dd") ·
                Ends @Model.Lease.EndDate.ToString("yyyy-MM-dd") (exclusive).</p></div>
    }
    @if (Model.Manager)
    {
        <partial name="_History" model="Model"/>
    }
</div>

