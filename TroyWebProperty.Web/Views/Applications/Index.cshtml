@using TroyWebProperty.Core
@model ApplicationListModel
@{
    ViewData["Title"] = "Applications";
    var manager = User.IsInRole(AppRoles.PropertyManager);
}
<div class="page-heading">
    <div><p class="eyebrow">@(manager ? "Management workspace" : "Your rental journey")</p>
        <h1>@(manager ? "Rental applications" : "My applications")</h1>
        <p class="text-body-secondary mb-0">@(manager ? "Review applications, follow progress, and help residents move forward." : "Keep track of your applications, all in one place.")</p>
    </div>
    <a class="btn btn-outline-primary" asp-controller="Units" asp-action="Index">Browse apartments
        <fa-icon name="arrow-right" trailing="true"/>
    </a></div>
@await Component.InvokeAsync("ApplicationCounts")
<section class="card filter-panel mb-4" aria-label="Filter applications">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-4"><label asp-for="Status">Application status</label><select asp-for="Status"
                                                                                            class="form-select"
                                                                                            data-no-field-validation>
                    <option value="">All statuses</option>
                    @foreach (var status in ApplicationRules.Statuses)
                    {
                        <option value="@status">@status</option>
                    }</select></div>
            <div class="col-md-4"><label asp-for="PropertyId">Property</label><select asp-for="PropertyId"
                                                                                      data-no-field-validation
                                                                                      asp-items="Model.Properties"
                                                                                      class="form-select">
                    <option value="">All properties</option>
                </select></div>
            <div class="col-md-4 d-flex gap-2">
                <button class="btn btn-primary" type="submit">
                    <fa-icon name="filter"/>
                    Apply filters
                </button>
                <a class="btn btn-outline-secondary" asp-action="Index">
                    <fa-icon name="rotate-left"/>
                    Reset</a></div>
        </form>
    </div>
</section>
<section class="card overflow-hidden" aria-labelledby="results-heading">
    <div class="card-header d-flex align-items-center justify-content-between"><h2 class="h5 mb-0" id="results-heading">
            Applications</h2><span
            class="text-body-secondary small">@Model.TotalCount result@(Model.TotalCount == 1 ? "" : "s")</span></div>
    @if (Model.Rows.Count > 0)
    {
        <div class="table-responsive" tabindex="0" role="region" aria-label="Applications">
            <table class="table table-hover mb-0">
                <caption class="visually-hidden">Applications matching the selected filters</caption>
                <thead>
                <tr>
                    <th scope="col">Applicant</th>
                    <th scope="col">Property / unit</th>
                    <th scope="col">Status</th>
                    <th scope="col">Created (UTC)</th>
                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        <td class="fw-semibold">@row.Applicant</td>
                        <td>@row.Property<span class="d-block small text-body-secondary">Unit @row.Unit</span></td>
                        <td>@Html.DisplayFor(model => row.Status, "ApplicationStatus")</td>
                        <td class="text-nowrap">@Html.DisplayFor(model => row.CreatedAt, "UtcDate")</td>
                        <td class="text-end"><a class="btn btn-sm btn-outline-primary text-nowrap" asp-action="Edit"
                                                asp-route-id="@row.Id" aria-label="Open application @row.Id">Open
                                application
                                <fa-icon name="arrow-right" trailing="true"/>
                            </a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state"><span class="empty-mark"><fa-icon name="magnifying-glass"/></span>
            <h3 class="h5">No applications match these filters.</h3>
            <p class="text-body-secondary">Try a different status or property, or explore available apartments.</p><a
                asp-action="Index" class="btn btn-outline-primary">Clear filters</a></div>
    }
</section>

@if (Model.TotalPages > 1)
{
    <nav class="d-flex flex-wrap align-items-center justify-content-between gap-3 mt-4" aria-label="Application pages">
        <p class="text-body-secondary mb-0">Page @Model.Page of @Model.TotalPages · @Model.TotalCount results</p>
        <ul class="pagination mb-0">
            <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                @if (Model.Page > 1)
                {
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)"
                       asp-route-status="@Model.Status" asp-route-propertyId="@Model.PropertyId" rel="prev">Previous</a>
                }
                else
                {
                    <span class="page-link" aria-disabled="true">Previous</span>
                }
            </li>
            <li class="page-item active"><span class="page-link" aria-current="page"><span
                        class="visually-hidden">Page </span>@Model.Page</span></li>
            <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
                @if (Model.Page < Model.TotalPages)
                {
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)"
                       asp-route-status="@Model.Status" asp-route-propertyId="@Model.PropertyId" rel="next">Next</a>
                }
                else
                {
                    <span class="page-link" aria-disabled="true">Next</span>
                }
            </li>
        </ul>
    </nav>
}
