<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>@ViewData["Title"] · Haven Rentals</title>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.8/dist/css/bootstrap.min.css"
          integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
          crossorigin="anonymous" referrerpolicy="no-referrer"
          asp-fallback-href="~/lib/bootstrap/dist/css/bootstrap.min.css?v=5.3.8"
          asp-fallback-test-class="visually-hidden"
          asp-fallback-test-property="position" asp-fallback-test-value="absolute"/>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/@@fortawesome/fontawesome-free@@7.3.1/css/fontawesome.min.css"
          integrity="sha384-m8DKa0MtZAZlyNgF18TSkQRYTPDY0sEELpwK2YijfYnVFH8kxiaO6hvopM168nue" crossorigin="anonymous"
          referrerpolicy="no-referrer"
          asp-fallback-href="~/lib/fontawesome/css/fontawesome.min.css?v=7.3.1" asp-fallback-test-class="fa"
          asp-fallback-test-property="display" asp-fallback-test-value="inline-block"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@fortawesome/fontawesome-free@@7.3.1/css/solid.min.css"
          integrity="sha384-p/nJzgOJxEnSeUkMQ0nk5oPsUT5x8eOWi6pxU2ls9qcO9B78dCvZk0JSAOXWXUQN" crossorigin="anonymous"
          referrerpolicy="no-referrer"
          asp-fallback-href="~/lib/fontawesome/css/solid.min.css?v=7.3.1" asp-fallback-test-class="fas"
          asp-fallback-test-property="--fa-style" asp-fallback-test-value="900"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
</head>
<body>
<a class="skip-link" href="#main-content">Skip to content</a>
<partial name="_Navigation"/>
<main id="main-content" class="container app-main" tabindex="-1">
    @if (TempData["Notice"] is string notice)
    {
        <div class="alert alert-info alert-dismissible fade show" role="status">@notice<button type="button"
                                                                                               class="btn-close"
                                                                                               data-bs-dismiss="alert"
                                                                                               aria-label="Dismiss notification"></button>
        </div>
    }
    @RenderBody()
</main>
<footer class="site-footer">
    <div class="container d-flex flex-wrap justify-content-between gap-2"><span>Haven Rentals</span><span>A little closer to home.</span>
    </div>
</footer>
<div class="modal fade" id="editorModal" tabindex="-1" aria-labelledby="modalTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content" id="modalContent"></div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/jquery@@3.7.1/dist/jquery.min.js"
        integrity="sha384-1H217gwSVyLSIfaLxHbE7dRb3v4mYCKbpQvzx0cegeju1MVsGrX5xXxAvs/HgeFs" crossorigin="anonymous"
        referrerpolicy="no-referrer"
        asp-fallback-src="~/lib/jquery/dist/jquery.min.js?v=3.7.1"
        asp-fallback-test="window.jQuery && window.jQuery.fn"></script>
<partial name="_ValidationScriptsPartial"/>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous" referrerpolicy="no-referrer"
        asp-fallback-src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js?v=5.3.8"
        asp-fallback-test="window.bootstrap && window.bootstrap.Modal && window.bootstrap.Collapse"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", false)
</body>
</html>
