@using TroyWebProperty.Core
@{ var current = ViewContext.RouteData.Values["controller"]?.ToString(); }
<header class="site-header">
    <nav class="navbar navbar-expand-lg" aria-label="Main navigation">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index"><span
                    class="brand-mark" aria-hidden="true">H</span><span>Haven<span class="brand-subtitle">RENTALS</span></span></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation"
                    aria-controls="mainNavigation" aria-expanded="false" aria-label="Toggle navigation"><span
                    class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="mainNavigation">
                <div class="navbar-nav ms-lg-4 me-auto gap-lg-2">
                    <a class="nav-link @(current == "Units" ? "active" : "")"
                       aria-current="@(current == "Units" ? "page" : null)" asp-controller="Units" asp-action="Index">
                        <fa-icon name="house"/>
                        Available units</a>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a class="nav-link @(current == "Applications" ? "active" : "")"
                           aria-current="@(current == "Applications" ? "page" : null)" asp-controller="Applications"
                           asp-action="Index">
                            <fa-icon name="file-lines"/>
                            Applications</a>
                    }
                    @if (User.IsInRole(AppRoles.PropertyManager))
                    {
                        <a class="nav-link @(current == "Properties" ? "active" : "")"
                           aria-current="@(current == "Properties" ? "page" : null)" asp-controller="Properties"
                           asp-action="Index">
                            <fa-icon name="building"/>
                            Properties &amp; units</a>
                    }
                </div>
                <partial name="_LoginPartial"/>
            </div>
        </div>
    </nav>
</header>
