@using TroyWebProperty.Core
@model IReadOnlyList<UnitRow>
@{ ViewData["Title"] = "Available apartments"; }
<div class="page-heading">
    <div><p class="eyebrow">A place to belong</p>
        <h1>Find your next home</h1>
        <p class="text-body-secondary mb-0">Browse apartments available today. Apply online and follow your
            application's progress.</p></div>
    <span class="badge availability-count">@Model.Count available</span></div>
<div class="row g-4 mt-1">
    @foreach (var unit in Model)
    {
        <div class="col-md-6 col-xl-4">
            <article class="card h-100 unit-card">
                <div class="unit-card-top" aria-hidden="true"><span class="unit-number">@unit.Number</span><span
                        class="unit-top-label">HAVEN RENTALS</span></div>
                <div class="card-body d-flex flex-column align-items-start">
                    <span class="badge text-bg-success mb-3">Available today</span>
                    <h2 class="h4">@unit.PropertyName</h2>
                    <p class="text-body-secondary">@unit.Address</p>
                    <p>Unit @unit.Number · @unit.Bedrooms bedroom(s) · @unit.Type</p>
                    <p class="unit-price mt-auto">@unit.Rent.ToString("C") / month</p>
                    @if (User.IsInRole(AppRoles.Applicant))
                    {
                        <form asp-controller="Applications" asp-action="Start" method="post"><input type="hidden"
                                                                                                    name="unitId"
                                                                                                    value="@unit.Id"/>
                            <button class="btn btn-primary mt-3" type="submit">Start application</button>
                        </form>
                    }
                    else if (User.Identity?.IsAuthenticated != true)
                    {
                        <a class="btn btn-primary mt-3" asp-controller="Account" asp-action="Login"
                           asp-route-returnUrl="/Units">Log in to apply</a>
                    }
                </div>
            </article>
        </div>
    }
</div>
@if (Model.Count == 0)
{
    <p class="alert alert-info">No units are currently available.</p>
}
