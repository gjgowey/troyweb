@model LoginViewModel
@{ ViewData["Title"] = "Log in"; }
<div class="auth-layout">
    <aside class="auth-intro"><p class="eyebrow">Haven Rentals</p>
        <h1>Welcome back</h1>
        <p class="lead">Log in to continue your rental journey.</p>
        <div class="auth-note"><span class="brand-mark" aria-hidden="true">H</span>
            <p>Find a place.<br/>Start a new chapter.</p></div>
    </aside>
    <section class="card card-body auth-card"><h2 class="h4 mb-2">Log in</h2>
        <p class="text-body-secondary mb-4">Enter your email and password below.</p>
        <form asp-action="Login" method="post" class="account-form">
            <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
            <input asp-for="ReturnUrl" type="hidden"/>
            <div class="form-field">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-control" autocomplete="username"/>
                <span asp-validation-for="Email"></span>
            </div>
            <div class="form-field">
                <label asp-for="Password"></label>
                <input asp-for="Password" class="form-control" autocomplete="current-password"/>
                <span asp-validation-for="Password"></span>
            </div>
            <div class="mb-3 form-check">
                <input asp-for="RememberMe" class="form-check-input"/>
                <label asp-for="RememberMe" class="form-check-label"></label>
            </div>
            <button class="btn btn-primary account-submit" type="submit">Log in</button>
            <a asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl">Create an account</a>
        </form>
    </section>
</div>

